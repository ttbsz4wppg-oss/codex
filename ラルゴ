<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <title>ラルゴ学びマッチング テストプレビュー</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Tailwind CSS（CDN版） -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- React 18 & ReactDOM（CDN版） -->
  <script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
  <!-- Babel（JSXをブラウザでそのまま動かす用） -->
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>
<body class="bg-slate-50">
  <div id="root"></div>

  <script type="text/babel">
    const { useState } = React;

    function LargoMatchingApp() {
      // 教える側の登録一覧
      const [teacherOffers, setTeacherOffers] = useState([]);
      // 学びたい側の登録一覧
      const [learnRequests, setLearnRequests] = useState([]);

      // 教える側フォーム
      const [teacherForm, setTeacherForm] = useState({
        name: "",
        contact: "",
        topics: "",         // "英検3級, 中1数学" など
        availableTime: "",  // 教えられる日程
        priceType: "per_hour",
        priceAmount: "",
        priceNote: "",
        message: "",
      });

      // 学びたい側フォーム
      const [learnForm, setLearnForm] = useState({
        name: "",
        contact: "",
        requestTopics: "",
        desiredTime: "",
        budgetMax: "",
        budgetNote: "",
        message: "",
      });

      // 教える側登録
      const handleAddTeacher = () => {
        if (!teacherForm.name || !teacherForm.contact || !teacherForm.topics) {
          alert("名前・連絡先・教えられる内容は必須です。");
          return;
        }

        const newOffer = {
          id: Date.now().toString(),
          ...teacherForm,
          priceAmount: Number(teacherForm.priceAmount || 0),
          createdAt: new Date().toISOString(),
        };

        setTeacherOffers(prev => [...prev, newOffer]);

        setTeacherForm({
          name: "",
          contact: "",
          topics: "",
          availableTime: "",
          priceType: "per_hour",
          priceAmount: "",
          priceNote: "",
          message: "",
        });
      };

      // 学びたい側登録
      const handleAddLearn = () => {
        if (!learnForm.name || !learnForm.contact || !learnForm.requestTopics) {
          alert("名前・連絡先・教えてほしい内容は必須です。");
          return;
        }

        const newRequest = {
          id: Date.now().toString(),
          ...learnForm,
          budgetMax: Number(learnForm.budgetMax || 0),
          createdAt: new Date().toISOString(),
        };

        setLearnRequests(prev => [...prev, newRequest]);

        setLearnForm({
          name: "",
          contact: "",
          requestTopics: "",
          desiredTime: "",
          budgetMax: "",
          budgetNote: "",
          message: "",
        });
      };

      return (
        <div className="min-h-screen bg-slate-50 p-4">
          <div className="max-w-5xl mx-auto">
            <h1 className="text-2xl font-bold mb-2">
              ラルゴの「教えたい × 教えてほしい」テストページ
            </h1>
            <p className="text-sm text-slate-600 mb-6">
              教える側・教えてほしい側の情報を登録すると、下の一覧にたまっていきます。まずは感覚を見るためのプレビュー版です。
            </p>

            <div className="grid md:grid-cols-2 gap-6 mb-8">
              {/* 教える側フォーム */}
              <div className="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                <h2 className="font-bold mb-3 text-lg text-emerald-700">教える側の登録</h2>

                <input
                  className="border border-slate-300 p-2 w-full mb-2 text-sm rounded"
                  placeholder="お名前"
                  value={teacherForm.name}
                  onChange={e => setTeacherForm(f => ({ ...f, name: e.target.value }))}
                />
                <input
                  className="border border-slate-300 p-2 w-full mb-2 text-sm rounded"
                  placeholder="連絡先（メールアドレスなど）"
                  value={teacherForm.contact}
                  onChange={e => setTeacherForm(f => ({ ...f, contact: e.target.value }))}
                />
                <textarea
                  className="border border-slate-300 p-2 w-full mb-2 text-sm rounded"
                  placeholder="教えられる内容（例：英検3級、英検準2級、中1数学、文章の書き方 など）"
                  value={teacherForm.topics}
                  onChange={e => setTeacherForm(f => ({ ...f, topics: e.target.value }))}
                />
                <textarea
                  className="border border-slate-300 p-2 w-full mb-2 text-sm rounded"
                  placeholder="教えられる日程（例：平日18〜21時、土曜午前 など）"
                  value={teacherForm.availableTime}
                  onChange={e => setTeacherForm(f => ({ ...f, availableTime: e.target.value }))}
                />

                <div className="flex gap-2 mb-2">
                  <select
                    className="border border-slate-300 p-2 text-sm rounded"
                    value={teacherForm.priceType}
                    onChange={e => setTeacherForm(f => ({ ...f, priceType: e.target.value }))}
                  >
                    <option value="per_hour">1時間あたり</option>
                    <option value="per_session">1回あたり</option>
                  </select>
                  <input
                    type="number"
                    className="border border-slate-300 p-2 text-sm w-full rounded"
                    placeholder="金額（円）"
                    value={teacherForm.priceAmount}
                    onChange={e => setTeacherForm(f => ({ ...f, priceAmount: e.target.value }))}
                  />
                </div>

                <input
                  className="border border-slate-300 p-2 w-full mb-2 text-sm rounded"
                  placeholder="料金に関する補足（例：初回はおためし料金 など）"
                  value={teacherForm.priceNote}
                  onChange={e => setTeacherForm(f => ({ ...f, priceNote: e.target.value }))}
                />

                <textarea
                  className="border border-slate-300 p-2 w-full mb-2 text-sm rounded"
                  placeholder="自己紹介・メッセージ（任意）"
                  value={teacherForm.message}
                  onChange={e => setTeacherForm(f => ({ ...f, message: e.target.value }))}
                />

                <button
                  className="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded text-sm"
                  onClick={handleAddTeacher}
                >
                  教える情報を登録する
                </button>
              </div>

              {/* 学びたい側フォーム */}
              <div className="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                <h2 className="font-bold mb-3 text-lg text-indigo-700">教えてほしい側の登録</h2>

                <input
                  className="border border-slate-300 p-2 w-full mb-2 text-sm rounded"
                  placeholder="お名前"
                  value={learnForm.name}
                  onChange={e => setLearnForm(f => ({ ...f, name: e.target.value }))}
                />
                <input
                  className="border border-slate-300 p-2 w-full mb-2 text-sm rounded"
                  placeholder="連絡先（メールアドレスなど）"
                  value={learnForm.contact}
                  onChange={e => setLearnForm(f => ({ ...f, contact: e.target.value }))}
                />
                <textarea
                  className="border border-slate-300 p-2 w-full mb-2 text-sm rounded"
                  placeholder="教えてほしい内容（例：英検準2級のライティング、分数の計算をやり直したい など）"
                  value={learnForm.requestTopics}
                  onChange={e => setLearnForm(f => ({ ...f, requestTopics: e.target.value }))}
                />
                <textarea
                  className="border border-slate-300 p-2 w-full mb-2 text-sm rounded"
                  placeholder="教えてもらいたい日程（例：水曜の夜、土日の午前中 など）"
                  value={learnForm.desiredTime}
                  onChange={e => setLearnForm(f => ({ ...f, desiredTime: e.target.value }))}
                />

                <div className="flex gap-2 mb-2 items-center">
                  <span className="text-xs text-slate-600 whitespace-nowrap">
                    予算（上限）
                  </span>
                  <input
                    type="number"
                    className="border border-slate-300 p-2 text-sm w-full rounded"
                    placeholder="これぐらいなら払える金額（円）"
                    value={learnForm.budgetMax}
                    onChange={e => setLearnForm(f => ({ ...f, budgetMax: e.target.value }))}
                  />
                </div>

                <input
                  className="border border-slate-300 p-2 w-full mb-2 text-sm rounded"
                  placeholder="予算に関する補足（例：月◯回でこの金額なら…など）"
                  value={learnForm.budgetNote}
                  onChange={e => setLearnForm(f => ({ ...f, budgetNote: e.target.value }))}
                />

                <textarea
                  className="border border-slate-300 p-2 w-full mb-2 text-sm rounded"
                  placeholder="その他メッセージ（任意）"
                  value={learnForm.message}
                  onChange={e => setLearnForm(f => ({ ...f, message: e.target.value }))}
                />

                <button
                  className="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded text-sm"
                  onClick={handleAddLearn}
                >
                  教えてほしい内容を登録する
                </button>
              </div>
            </div>

            {/* 一覧表示（ラルゴが見るイメージ） */}
            <div className="grid md:grid-cols-2 gap-6">
              <div className="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                <h3 className="font-bold mb-2">教える側の登録一覧</h3>
                <ul className="text-sm space-y-3 max-h-72 overflow-y-auto">
                  {teacherOffers.map(t => (
                    <li key={t.id} className="border-b pb-2">
                      <div className="font-semibold">{t.name}</div>
                      <div className="text-xs text-slate-500 mb-1">
                        教えられる内容: {t.topics}
                      </div>
                      <div className="text-xs text-slate-500 mb-1">
                        日程: {t.availableTime}
                      </div>
                      <div className="text-xs text-slate-500 mb-1">
                        料金: {t.priceType === "per_hour" ? "1時間あたり" : "1回あたり"}{" "}
                        {t.priceAmount
                          ? t.priceAmount.toLocaleString()
                          : "未設定"}{" "}
                        円
                        {t.priceNote && `（${t.priceNote}）`}
                      </div>
                    </li>
                  ))}
                  {teacherOffers.length === 0 && (
                    <li className="text-xs text-slate-400">
                      まだ登録はありません。
                    </li>
                  )}
                </ul>
              </div>

              <div className="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                <h3 className="font-bold mb-2">教えてほしい側の登録一覧</h3>
                <ul className="text-sm space-y-3 max-h-72 overflow-y-auto">
                  {learnRequests.map(r => (
                    <li key={r.id} className="border-b pb-2">
                      <div className="font-semibold">{r.name}</div>
                      <div className="text-xs text-slate-500 mb-1">
                        教えてほしい内容: {r.requestTopics}
                      </div>
                      <div className="text-xs text-slate-500 mb-1">
                        希望日程: {r.desiredTime}
                      </div>
                      <div className="text-xs text-slate-500 mb-1">
                        予算上限:{" "}
                        {r.budgetMax
                          ? r.budgetMax.toLocaleString()
                          : "未設定"}{" "}
                        円
                        {r.budgetNote && `（${r.budgetNote}）`}
                      </div>
                    </li>
                  ))}
                  {learnRequests.length === 0 && (
                    <li className="text-xs text-slate-400">
                      まだ登録はありません。
                    </li>
                  )}
                </ul>
              </div>
            </div>
          </div>
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById("root"));
    root.render(<LargoMatchingApp />);
  </script>
</body>
</html>
